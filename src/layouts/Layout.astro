---
import '../styles/global.css';
import type { SiteConfig } from '../site.config';

interface Props {
  siteConfig: SiteConfig;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { personal, theme } = Astro.props.siteConfig;
const title = Astro.props.title ?? `${personal.name} - ${personal.role}`;
const description = Astro.props.description ?? personal.description;
---

<!doctype html>
<html lang="pt-BR" style={`--color-primary: ${theme.primary}; --color-secondary: ${theme.secondary};`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
	</head>
	<body class="bg-white text-slate-800 antialiased">
		<slot />
	</body>
</html>
