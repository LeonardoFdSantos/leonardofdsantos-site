---
import '../styles/global.css';
import type { SiteConfig } from '../site.config';

interface Props {
  siteConfig: SiteConfig;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { personal, theme, seo } = Astro.props.siteConfig;
const title = Astro.props.title ?? `${personal.name} - ${personal.role}`;
const description = Astro.props.description ?? personal.description;

const SITE_URL = "https://leonardofdsantos.com.br";
const FALLBACK_OG_IMAGE = "https://images.unsplash.com/photo-1638482856830-16b0e15fcf2c?w=1200&h=630&fit=crop&q=80";
const ogImage = seo?.ogImage ?? FALLBACK_OG_IMAGE;
const canonicalUrl = `${SITE_URL}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="pt-BR" style={`--color-primary: ${theme.primary}; --color-secondary: ${theme.secondary};`}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		{Astro.props.noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={personal.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="pt_BR" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>
	</head>
	<body class="bg-white text-slate-800 antialiased">
		<slot />
	</body>
</html>
