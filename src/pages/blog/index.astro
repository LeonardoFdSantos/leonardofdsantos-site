---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getSiteContent } from '../../lib/content';

const siteConfig = await getSiteContent();
// Ordena posts do mais novo para o mais velho (decrescente por data)
const meses: Record<string, string> = {
  "Janeiro": "01", "Fevereiro": "02", "Março": "03", "Abril": "04",
  "Maio": "05", "Junho": "06", "Julho": "07", "Agosto": "08",
  "Setembro": "09", "Outubro": "10", "Novembro": "11", "Dezembro": "12"
};

const parseDate = (dateStr: string) => {
  // Ex: "10 de Outubro, 2025"
  const [dia, resto] = dateStr.split(' de ');
  const [mes, ano] = resto.split(', ');
  return new Date(`${ano}-${meses[mes]}-${dia.padStart(2, '0')}`);
};

const posts = [...siteConfig.blogPosts].sort((a, b) => {
  return parseDate(b.date).getTime() - parseDate(a.date).getTime();
});

const featuredPost = posts[0];
const otherPosts = posts.slice(1);
---

<Layout siteConfig={siteConfig} title="Blog & Artigos sobre Criação de Sites — Leonardo Santos">
  <Header siteConfig={siteConfig} />

  <main class="py-20 px-4 sm:px-6 max-w-6xl mx-auto">
    <!-- Cabeçalho -->
    <div class="mb-14 text-center max-w-2xl mx-auto">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[var(--color-primary)] bg-[var(--color-primary)]/10 px-3.5 py-1 rounded-full mb-4">
        📚 Conteúdo Exclusivo
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[var(--color-secondary)] tracking-tight">Blog & Dicas Práticas</h1>
      <p class="mt-4 text-lg text-slate-600">Conteúdos exclusivos sobre presença digital, SEO local e como atrair mais clientes para o seu negócio em Santa Maria - RS.</p>
    </div>

    {/* Post em Destaque */}
    {featuredPost && (
      <section class="mb-16">
        <div class="group relative grid lg:grid-cols-12 gap-8 items-center bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/50 overflow-hidden hover:shadow-2xl transition-all duration-300">
          {featuredPost.image && (
            <div class="lg:col-span-7 h-72 sm:h-96 overflow-hidden bg-slate-100">
              <img src={featuredPost.image} alt={featuredPost.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          )}
          <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 text-xs font-semibold text-slate-400 mb-3">
              <span class="bg-[var(--color-primary)]/10 text-[var(--color-primary)] px-2.5 py-1 rounded-md">Destaque</span>
              <span>{featuredPost.date}</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-secondary)] leading-tight">
              <a href={`/blog/${featuredPost.slug}`} class="hover:text-[var(--color-primary)] transition-colors">{featuredPost.title}</a>
            </h2>
            <p class="mt-4 text-slate-600 text-sm sm:text-base leading-relaxed">{featuredPost.description}</p>
            <div class="mt-6">
              <a href={`/blog/${featuredPost.slug}`} class="inline-flex items-center gap-2 text-sm font-bold text-[var(--color-primary)] hover:translate-x-1 transition-transform">
                Ler artigo completo &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Grid dos demais posts */}
    {otherPosts.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {otherPosts.map((post) => (
          <article class="group flex flex-col bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            {post.image ? (
              <div class="h-48 overflow-hidden bg-slate-100">
                <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
            ) : (
              <div class="h-48 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center text-3xl">📰</div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <time class="text-xs font-semibold text-slate-400 mb-2">{post.date}</time>
              <h3 class="text-xl font-bold text-[var(--color-secondary)] leading-snug">
                <a href={`/blog/${post.slug}`} class="hover:text-[var(--color-primary)] transition-colors">{post.title}</a>
              </h3>
              <p class="mt-3 text-sm text-slate-600 line-clamp-3 flex-1 leading-relaxed">{post.description}</p>
              <div class="mt-6 pt-4 border-t border-slate-100">
                <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-1.5 text-sm font-bold text-[var(--color-primary)] hover:translate-x-1 transition-transform">
                  Ler artigo &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </main>

  <Footer siteConfig={siteConfig} />
  <WhatsAppButton siteConfig={siteConfig} />
</Layout>