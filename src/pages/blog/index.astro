---
import Layout from '../../layouts/Layout.astro';
import { defaultSiteConfig } from '../../site.config';
import { getSiteContent } from '../../lib/content';

const siteConfig = await getSiteContent();
---

<Layout siteConfig={siteConfig} title="Blog sobre Criação de Sites e Desenvolvimento Web — Leonardo Santos">
  <main class="py-20 px-4 sm:px-6 max-w-4xl mx-auto">
    <div class="mb-12">
      <a href="/" class="text-sm font-semibold text-[var(--color-primary)] hover:underline">&larr; Voltar para a Página Inicial</a>
      <h1 class="mt-4 text-4xl font-extrabold text-[var(--color-secondary)] tracking-tight">Blog & Artigos</h1>
      <p class="mt-2 text-lg text-slate-600">Dicas e conteúdos sobre criação de sites, SEO e presença digital para negócios locais.</p>
    </div>

    <div class="grid gap-8">
      {siteConfig.blogPosts.map((post) => (
        <article class="p-6 rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-md transition-shadow">
          {post.image && <img src={post.image} alt={post.title} class="w-full h-48 object-cover rounded-xl mb-4" />}
          <time class="text-xs font-medium text-slate-400">{post.date}</time>
          <h2 class="mt-2 text-2xl font-bold text-[var(--color-secondary)]">
            <a href={`/blog/${post.slug}`} class="hover:text-[var(--color-primary)] transition-colors">{post.title}</a>
          </h2>
          <p class="mt-3 text-slate-600">{post.description}</p>
          <div class="mt-4">
            <a href={`/blog/${post.slug}`} class="text-sm font-semibold text-[var(--color-primary)] hover:underline">Ler artigo &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>