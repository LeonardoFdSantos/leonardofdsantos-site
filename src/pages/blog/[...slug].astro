---
import Layout from '../../layouts/Layout.astro';
import { defaultSiteConfig } from '../../site.config';
import { getSiteContent } from '../../lib/content';

export function getStaticPaths() {
  // Para suporte a rotas estáticas na Vercel com os slugs padrão
  return [
    { params: { slug: 'criacao-sites-santa-maria' } },
    { params: { slug: 'desenvolvimento-web-rapido' } },
    { params: { slug: 'quanto-custa-criar-um-site-em-santa-maria-2025' } }
  ];
}

const { slug } = Astro.params;
const siteConfig = await getSiteContent();
const post = siteConfig.blogPosts.find((p) => p.slug === slug) || siteConfig.blogPosts[0];
---

<Layout siteConfig={siteConfig} title={`${post.title} — Blog Leonardo Santos`} description={post.description}>
  <main class="py-20 px-4 sm:px-6 max-w-3xl mx-auto">
    <div class="mb-8">
      <a href="/blog" class="text-sm font-semibold text-[var(--color-primary)] hover:underline">&larr; Voltar para o Blog</a>
      <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold text-[var(--color-secondary)] tracking-tight">{post.title}</h1>
      <time class="mt-2 block text-sm text-slate-500">{post.date}</time>
    </div>

    {post.image && (
      <div class="mb-8">
        <img src={post.image} alt={post.title} class="w-full h-80 object-cover rounded-2xl shadow-md" />
      </div>
    )}

    <article class="prose prose-slate lg:prose-lg max-w-none space-y-6 text-slate-700 leading-relaxed" set:html={post.content} />
  </main>
</Layout>