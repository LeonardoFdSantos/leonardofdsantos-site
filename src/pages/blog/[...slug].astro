---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getSiteContent } from '../../lib/content';

export function getStaticPaths() {
  return [
    { params: { slug: 'criacao-sites-rio-grande-do-sul' } },
    { params: { slug: 'desenvolvimento-web-rapido-rs' } },
    { params: { slug: 'quanto-custa-criar-um-site-rs-2025' } },
    { params: { slug: 'seo-local-comercios-rs' } },
    { params: { slug: 'por-que-evitar-wordpress-empresas-rs' } },
    { params: { slug: 'como-atrair-clientes-whatsapp-site-rs' } },
    { params: { slug: 'criacao-sites-porto-alegre' } },
    { params: { slug: 'criacao-sites-caxias-do-sul' } },
    { params: { slug: 'criacao-sites-pelotas' } },
    { params: { slug: 'criacao-sites-santa-maria-rs' } },
    { params: { slug: 'criacao-sites-canoas' } },
    { params: { slug: 'site-oficina-mecanica-rs' } },
    { params: { slug: 'site-saloes-beleza-rs' } },
    { params: { slug: 'site-clinicas-medicas-rs' } },
    { params: { slug: 'site-lojas-materiais-construcao-rs' } },
    { params: { slug: 'site-imobiliarias-rs' } }
  ];
}

const { slug } = Astro.params;
const siteConfig = await getSiteContent();
const post = siteConfig.blogPosts.find((p) => p.slug === slug) || siteConfig.blogPosts[0];
---

<Layout siteConfig={siteConfig} title={`${post.title} — Blog Leonardo Santos`} description={post.description}>
  <Header siteConfig={siteConfig} />

  <main class="py-20 px-4 sm:px-6 max-w-3xl mx-auto">
    <div class="mb-8">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-bold text-[var(--color-primary)] hover:underline mb-4">
        &larr; Voltar para o Blog
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-secondary)] tracking-tight leading-tight">{post.title}</h1>
      <time class="mt-3 block text-sm text-slate-500 font-medium">{post.date}</time>
    </div>

    {post.image && (
      <div class="mb-10 rounded-3xl overflow-hidden shadow-xl border border-slate-200/80">
        <img src={post.image} alt={post.title} class="w-full h-80 sm:h-96 object-cover" />
      </div>
    )}

    <article class="prose prose-slate lg:prose-lg max-w-none space-y-6 text-slate-700 leading-relaxed bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm">
      <div set:html={post.content} />
    </article>
  </main>

  <Footer siteConfig={siteConfig} />
  <WhatsAppButton siteConfig={siteConfig} />
</Layout>