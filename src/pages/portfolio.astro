---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getSiteContent } from '../lib/content';

const siteConfig = await getSiteContent();
const portfolio = siteConfig.portfolio;
---

<Layout siteConfig={siteConfig} title={`Portfólio de Sites — ${siteConfig.personal.name}`}>
  <Header siteConfig={siteConfig} />

  <main class="py-20 px-4 sm:px-6 max-w-6xl mx-auto">
    <div class="mb-14 text-center max-w-2xl mx-auto">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[var(--color-primary)] bg-[var(--color-primary)]/10 px-3.5 py-1 rounded-full mb-4">
        💼 Nossos Trabalhos
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-[var(--color-secondary)] tracking-tight">Portfólio de Projetos</h1>
      <p class="mt-4 text-lg text-slate-600">Cada projeto abaixo foi desenvolvido sob medida para o nicho do cliente, garantindo velocidade, design moderno e alta conversão.</p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2">
      {portfolio.map((item) => {
        const isEncerrado = item.status === "encerrado";
        return (
          <div
            class:list={[
              "group overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm transition-all duration-300",
              isEncerrado ? "opacity-70" : "hover:shadow-xl hover:-translate-y-1",
            ]}
          >
            <div class="relative h-56 overflow-hidden bg-slate-100">
              {item.image ? (
                <img
                  src={item.image}
                  alt={item.name}
                  loading="lazy"
                  class:list={[
                    "h-full w-full object-cover transition-transform duration-500",
                    isEncerrado ? "grayscale" : "group-hover:scale-105",
                  ]}
                />
              ) : (
                <div class="h-full w-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)]" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/0 to-black/0" />
              <span class="absolute left-5 top-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-white/95 text-2xl shadow-md backdrop-blur-sm">
                {item.icon}
              </span>
              <span class="absolute right-5 top-5 rounded-full bg-white/95 px-3.5 py-1 text-xs font-bold text-slate-700 shadow-sm backdrop-blur-sm">
                {item.niche}
              </span>
            </div>
            <div class="p-8">
              <h3 class="text-2xl font-bold text-[var(--color-secondary)]">{item.name}</h3>
              <p class="mt-3 text-slate-600 leading-relaxed">{item.description}</p>
              {isEncerrado ? (
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-slate-400">
                  <span class="h-2 w-2 rounded-full bg-slate-400" />
                  Projeto encerrado
                </span>
              ) : item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-[var(--color-primary)] group-hover:gap-3 transition-all"
                >
                  Ver site em funcionamento <span aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="mt-6 inline-block text-sm font-semibold text-slate-400">
                  Demo em produção
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </main>

  <Footer siteConfig={siteConfig} />
  <WhatsAppButton siteConfig={siteConfig} />
</Layout>