---
// Painel de administração: login (Supabase Auth) + editor de conteúdo +
// lista de leads. Tudo roda client-side (o HTML desta página não tem
// nenhum dado sensível — a proteção real é o RLS do Supabase: sem
// sessão autenticada, não dá pra ler leads nem gravar conteúdo).
import Layout from '../../layouts/Layout.astro';
import { defaultSiteConfig } from '../../site.config';

const nameParts = defaultSiteConfig.personal.name.trim().split(/\s+/);
const initials = (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase();
---

<Layout siteConfig={defaultSiteConfig} title="Admin — leonardofdsantos.com.br" description="Painel administrativo" noindex>
	<div id="admin-unconfigured" class="hidden mx-auto max-w-lg px-4 py-24 text-center">
		<div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-100 text-2xl">⚠️</div>
		<h1 class="mt-4 text-lg font-bold text-[var(--color-secondary)]">Supabase não configurado</h1>
		<p class="mt-2 text-sm text-slate-500">
			Defina <code class="rounded bg-slate-100 px-1.5 py-0.5">PUBLIC_SUPABASE_URL</code> e
			<code class="rounded bg-slate-100 px-1.5 py-0.5">PUBLIC_SUPABASE_ANON_KEY</code> no
			<code class="rounded bg-slate-100 px-1.5 py-0.5">.env</code> (veja o README) e reinicie o site.
		</p>
	</div>

	<div id="admin-login" class="hidden relative min-h-screen overflow-hidden bg-white">
		<div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-[var(--color-primary)]/15 blur-3xl"></div>
		<div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-[var(--color-secondary)]/10 blur-3xl"></div>
		<div class="relative mx-auto flex min-h-screen max-w-sm flex-col items-center justify-center px-4 py-16">
			<div class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)] text-xl font-extrabold text-white shadow-lg shadow-[var(--color-primary)]/30">
				{initials}
			</div>
			<h1 class="mt-5 text-2xl font-bold text-[var(--color-secondary)]">Painel administrativo</h1>
			<p class="mt-1 text-sm text-slate-500">Acesso restrito ao administrador do site.</p>
			<form id="login-form" class="mt-8 w-full space-y-3">
				<input
					type="email"
					id="login-email"
					placeholder="E-mail"
					required
					class="field"
				/>
				<input
					type="password"
					id="login-password"
					placeholder="Senha"
					required
					class="field"
				/>
				<button type="submit" class="w-full rounded-full bg-[var(--color-primary)] px-4 py-3 text-sm font-semibold text-white shadow-md shadow-[var(--color-primary)]/30 hover:opacity-90 transition-opacity">
					Entrar
				</button>
				<p id="login-error" class="hidden text-center text-sm text-red-600"></p>
			</form>
		</div>
	</div>

	<div id="admin-dashboard" class="hidden min-h-screen bg-slate-50">
		<header class="sticky top-0 z-20 border-b border-slate-100 bg-white/90 backdrop-blur-md">
			<div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3.5 sm:px-6">
				<div class="flex items-center gap-2.5">
					<span class="flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-primary)] text-sm font-bold text-white">
						{initials}
					</span>
					<span class="font-bold text-[var(--color-secondary)]">Painel</span>
				</div>
				<div class="flex items-center gap-3">
					<a href="/" class="text-sm font-medium text-slate-500 hover:text-[var(--color-primary)] transition-colors">Ver site ↗</a>
					<button id="logout-btn" class="rounded-full border border-slate-200 px-4 py-1.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-colors">
						Sair
					</button>
				</div>
			</div>
		</header>

		<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
			<div class="flex gap-2">
				<button data-tab="conteudo" class="tab-btn is-active">
					📝 Conteúdo
				</button>
				<button data-tab="leads" class="tab-btn">
					💬 Leads
				</button>
			</div>

			<section id="tab-conteudo" class="tab-panel mt-6 space-y-6">
				<p id="save-status" class="hidden rounded-xl px-4 py-3 text-sm font-medium"></p>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">👤</span> Dados pessoais</h2>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<label class="field-group"><span class="label">Nome</span><input data-field="personal.name" class="field" /></label>
						<label class="field-group"><span class="label">Cargo/atuação</span><input data-field="personal.role" class="field" /></label>
						<label class="field-group sm:col-span-2"><span class="label">Tagline curta</span><input data-field="personal.tagline" class="field" /></label>
						<label class="field-group sm:col-span-2"><span class="label">Descrição</span><textarea data-field="personal.description" rows="2" class="field"></textarea></label>
						<label class="field-group"><span class="label">Cidade</span><input data-field="personal.city" class="field" /></label>
						<label class="field-group"><span class="label">WhatsApp (só dígitos, com DDI)</span><input data-field="personal.whatsapp" class="field" /></label>
						<label class="field-group"><span class="label">Instagram (sem @)</span><input data-field="personal.instagram" class="field" /></label>
						<label class="field-group"><span class="label">E-mail</span><input data-field="personal.email" class="field" /></label>
					</div>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">🎨</span> Cores do tema</h2>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<label class="field-group"><span class="label">Cor primária (hex)</span><input data-field="theme.primary" class="field" /></label>
						<label class="field-group"><span class="label">Cor secundária (hex)</span><input data-field="theme.secondary" class="field" /></label>
					</div>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">🚀</span> Hero</h2>
					<div class="mt-4 grid gap-4">
						<label class="field-group"><span class="label">Badge</span><input data-field="hero.badge" class="field" /></label>
						<label class="field-group"><span class="label">Título principal</span><input data-field="hero.headline" class="field" /></label>
						<label class="field-group"><span class="label">Subtítulo</span><textarea data-field="hero.subheadline" rows="2" class="field"></textarea></label>
						<label class="field-group"><span class="label">Texto do botão</span><input data-field="hero.ctaText" class="field" /></label>
						<label class="field-group">
							<span class="label">Estatísticas — JSON, array de {`{value, label}`}</span>
							<textarea data-field-json="hero.stats" rows="5" class="field field-code"></textarea>
						</label>
					</div>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">🙋</span> Sobre</h2>
					<div class="mt-4 grid gap-4">
						<label class="field-group"><span class="label">Título da seção</span><input data-field="about.title" class="field" /></label>
						<label class="field-group"><span class="label">Texto</span><textarea data-field="about.text" rows="3" class="field"></textarea></label>
						<label class="field-group">
							<span class="label">Fotos — JSON, array de URLs (a 1ª é a foto principal)</span>
							<textarea id="about-photos-input" data-field-json="about.photos" rows="3" class="field field-code"></textarea>
						</label>
						<div id="photos-preview" class="flex flex-wrap gap-3"></div>
						<label class="field-group">
							<span class="label">Diferenciais — JSON, array de {`{icon, title, text}`}</span>
							<textarea data-field-json="about.highlights" rows="6" class="field field-code"></textarea>
						</label>
					</div>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">💼</span> Portfólio</h2>
					<label class="field-group mt-4">
						<span class="label">JSON — array de {`{name, niche, description, icon, url?, status?: "encerrado"}`}</span>
						<textarea data-field-json="portfolio" rows="10" class="field field-code"></textarea>
					</label>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">💳</span> Planos</h2>
					<label class="field-group mt-4">
						<span class="label">JSON — array de {`{name, setupPrice, monthlyPrice, features: string[], highlighted?}`}</span>
						<textarea data-field-json="planos" rows="12" class="field field-code"></textarea>
					</label>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">📬</span> Contato</h2>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<label class="field-group"><span class="label">Chave Web3Forms</span><input data-field="contact.web3formsKey" class="field" /></label>
						<label class="flex items-center gap-2 self-end pb-2.5 text-sm text-slate-600">
							<input type="checkbox" data-field-checkbox="contact.showForm" class="h-4 w-4 rounded border-slate-300 text-[var(--color-primary)]" />
							Mostrar formulário de contato
						</label>
					</div>
				</div>

				<div class="card">
					<h2 class="card-title"><span class="card-icon">🔗</span> Compartilhamento (SEO)</h2>
					<div class="mt-4 grid gap-4">
						<label class="field-group">
							<span class="label">Imagem de preview — aparece quando o link é compartilhado (1200x630 recomendado)</span>
							<input id="og-image-input" data-field="seo.ogImage" class="field" />
						</label>
						<img id="og-image-preview" class="hidden w-full max-w-sm rounded-xl border border-slate-200 object-cover" style="aspect-ratio: 1200/630" />
					</div>
				</div>

				<button id="save-btn" class="sticky bottom-6 w-full rounded-full bg-[var(--color-primary)] px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-[var(--color-primary)]/30 hover:opacity-90 transition-opacity">
					Salvar alterações
				</button>
			</section>

			<section id="tab-leads" class="tab-panel mt-6 hidden">
				<div id="leads-list" class="space-y-3"></div>
				<div id="leads-empty" class="hidden rounded-2xl border border-dashed border-slate-200 py-16 text-center">
					<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-xl">📭</div>
					<p class="mt-3 text-sm text-slate-400">Nenhum lead ainda.</p>
				</div>
			</section>
		</div>
	</div>
</Layout>

<style>
	.field {
		width: 100%;
		border-radius: 0.625rem;
		border: 1px solid rgb(226 232 240);
		background: rgb(248 250 252);
		padding: 0.625rem 1rem;
		font-size: 0.875rem;
		transition: border-color 0.15s, background-color 0.15s;
	}
	.field:focus {
		outline: none;
		border-color: var(--color-primary);
		background: white;
	}
	.field-code {
		font-family: ui-monospace, "SF Mono", Menlo, monospace;
		font-size: 0.75rem;
		background: rgb(15 23 42);
		color: rgb(226 232 240);
		border-color: rgb(15 23 42);
	}
	.field-code:focus {
		background: rgb(15 23 42);
		border-color: var(--color-primary);
	}
	.field-group {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.label {
		font-size: 0.75rem;
		font-weight: 600;
		color: rgb(100 116 139);
	}
	.card {
		border-radius: 1.25rem;
		border: 1px solid rgb(241 245 249);
		background: white;
		padding: 1.5rem;
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
	}
	.card-title {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-secondary);
	}
	.card-icon {
		display: flex;
		height: 2rem;
		width: 2rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.625rem;
		background: rgb(248 250 252);
		font-size: 1rem;
	}
	.tab-btn {
		border-radius: 9999px;
		padding: 0.5rem 1.125rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: rgb(100 116 139);
		transition: background-color 0.15s, color 0.15s;
	}
	.tab-btn:hover {
		background: rgb(241 245 249);
	}
	.tab-btn.is-active {
		background: var(--color-primary);
		color: white;
	}
	.photo-thumb {
		height: 5rem;
		width: 5rem;
		border-radius: 0.75rem;
		object-fit: cover;
		border: 1px solid rgb(226 232 240);
	}
</style>

<script>
	import { supabase, isSupabaseConfigured } from '../../lib/supabase';
	import { defaultSiteConfig, type SiteConfig } from '../../site.config';

	const $ = (sel: string) => document.querySelector(sel) as HTMLElement;

	const unconfiguredEl = $('#admin-unconfigured');
	const loginEl = $('#admin-login');
	const dashboardEl = $('#admin-dashboard');

	if (!isSupabaseConfigured || !supabase) {
		unconfiguredEl.classList.remove('hidden');
	} else {
		init(supabase);
	}

	function init(supabase: NonNullable<typeof import('../../lib/supabase').supabase>) {
		let currentContent: SiteConfig = defaultSiteConfig;

		// --- Auth ---
		supabase.auth.getSession().then(({ data }) => {
			if (data.session) showDashboard();
			else showLogin();
		});

		function showLogin() {
			loginEl.classList.remove('hidden');
			dashboardEl.classList.add('hidden');
		}

		async function showDashboard() {
			loginEl.classList.add('hidden');
			dashboardEl.classList.remove('hidden');
			await loadContent();
			await loadLeads();
		}

		$('#login-form').addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = (document.getElementById('login-email') as HTMLInputElement).value;
			const password = (document.getElementById('login-password') as HTMLInputElement).value;
			const errorEl = $('#login-error');
			const { error } = await supabase.auth.signInWithPassword({ email, password });
			if (error) {
				errorEl.textContent = 'E-mail ou senha inválidos.';
				errorEl.classList.remove('hidden');
				return;
			}
			errorEl.classList.add('hidden');
			showDashboard();
		});

		$('#logout-btn').addEventListener('click', async () => {
			await supabase.auth.signOut();
			showLogin();
		});

		// --- Tabs ---
		document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');

				document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
				$(`#tab-${btn.dataset.tab}`).classList.remove('hidden');
			});
		});

		// --- Conteúdo: carregar/salvar ---
		function getByPath(obj: any, path: string) {
			return path.split('.').reduce((acc, key) => acc?.[key], obj);
		}
		function setByPath(obj: any, path: string, value: unknown) {
			const keys = path.split('.');
			const last = keys.pop()!;
			const target = keys.reduce((acc, key) => acc[key], obj);
			target[last] = value;
		}

		function renderPhotoPreviews() {
			const textarea = document.getElementById('about-photos-input') as HTMLTextAreaElement;
			const previewEl = $('#photos-preview');
			if (!textarea || !previewEl) return;
			try {
				const urls: string[] = JSON.parse(textarea.value);
				previewEl.innerHTML = urls
					.filter((u) => typeof u === 'string' && u)
					.map((u) => `<img src="${u}" class="photo-thumb" loading="lazy" />`)
					.join('');
			} catch {
				// deixa a última prévia válida na tela enquanto o JSON está incompleto
			}
		}

		function renderOgImagePreview() {
			const input = document.getElementById('og-image-input') as HTMLInputElement;
			const img = document.getElementById('og-image-preview') as HTMLImageElement;
			if (!input?.value) {
				img.classList.add('hidden');
				return;
			}
			img.src = input.value;
			img.classList.remove('hidden');
		}

		async function loadContent() {
			const { data, error } = await supabase.from('site_content').select('data').eq('id', 'main').maybeSingle();
			currentContent = !error && data?.data ? (data.data as SiteConfig) : structuredClone(defaultSiteConfig);

			// Preenche campos novos (adicionados depois do último save) com o
			// padrão, pra não aparecer em branco em conteúdo salvo antes deles existirem.
			currentContent.seo = currentContent.seo ?? structuredClone(defaultSiteConfig.seo);
			currentContent.about.photos = currentContent.about.photos ?? structuredClone(defaultSiteConfig.about.photos);

			document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field]').forEach((el) => {
				el.value = getByPath(currentContent, el.dataset.field!) ?? '';
			});
			document.querySelectorAll<HTMLTextAreaElement>('[data-field-json]').forEach((el) => {
				el.value = JSON.stringify(getByPath(currentContent, el.dataset.fieldJson!) ?? [], null, 2);
			});
			document.querySelectorAll<HTMLInputElement>('[data-field-checkbox]').forEach((el) => {
				el.checked = Boolean(getByPath(currentContent, el.dataset.fieldCheckbox!));
			});

			renderPhotoPreviews();
			renderOgImagePreview();
			document.getElementById('about-photos-input')?.addEventListener('input', renderPhotoPreviews);
			document.getElementById('og-image-input')?.addEventListener('input', renderOgImagePreview);
		}

		$('#save-btn').addEventListener('click', async () => {
			const statusEl = $('#save-status');
			const updated: SiteConfig = structuredClone(currentContent);

			try {
				document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-field]').forEach((el) => {
					setByPath(updated, el.dataset.field!, el.value);
				});
				document.querySelectorAll<HTMLTextAreaElement>('[data-field-json]').forEach((el) => {
					setByPath(updated, el.dataset.fieldJson!, JSON.parse(el.value));
				});
				document.querySelectorAll<HTMLInputElement>('[data-field-checkbox]').forEach((el) => {
					setByPath(updated, el.dataset.fieldCheckbox!, el.checked);
				});
			} catch {
				statusEl.textContent = 'Algum campo JSON está com formato inválido — confira colchetes/vírgulas.';
				statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-red-50 text-red-700';
				statusEl.classList.remove('hidden');
				return;
			}

			const { error } = await supabase
				.from('site_content')
				.upsert({ id: 'main', data: updated, updated_at: new Date().toISOString() });

			if (error) {
				statusEl.textContent = `Erro ao salvar: ${error.message}`;
				statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-red-50 text-red-700';
			} else {
				currentContent = updated;
				statusEl.textContent = 'Salvo! O site já reflete as mudanças.';
				statusEl.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-emerald-50 text-emerald-700';
			}
			statusEl.classList.remove('hidden');
		});

		// --- Leads ---
		function initialsOf(name: string) {
			const parts = name.trim().split(/\s+/).filter(Boolean);
			if (parts.length === 0) return '?';
			if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
			return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
		}

		async function loadLeads() {
			const listEl = $('#leads-list');
			const emptyEl = $('#leads-empty');
			const { data, error } = await supabase
				.from('leads')
				.select('*')
				.order('created_at', { ascending: false });

			listEl.innerHTML = '';
			if (error || !data || data.length === 0) {
				emptyEl.classList.remove('hidden');
				return;
			}
			emptyEl.classList.add('hidden');

			for (const lead of data) {
				const date = new Date(lead.created_at).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' });
				const waDigits = String(lead.phone).replace(/\D/g, '');
				const card = document.createElement('div');
				card.className = 'flex items-start gap-4 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm';
				card.innerHTML = `
					<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary)]/10 text-sm font-bold text-[var(--color-primary)]">
						${escapeHtml(initialsOf(lead.name))}
					</div>
					<div class="min-w-0 flex-1">
						<div class="flex items-center justify-between gap-2">
							<p class="font-semibold text-[var(--color-secondary)]">${escapeHtml(lead.name)}</p>
							<span class="shrink-0 text-xs text-slate-400">${date}</span>
						</div>
						<p class="mt-1 text-sm text-slate-600">${escapeHtml(lead.message)}</p>
						<div class="mt-2.5 flex items-center gap-4 text-xs">
							<a href="https://wa.me/${waDigits}" target="_blank" rel="noopener noreferrer" class="font-semibold text-emerald-600 hover:underline">💬 ${escapeHtml(lead.phone)}</a>
							<button data-delete-lead="${lead.id}" class="font-semibold text-red-500 hover:underline">Excluir</button>
						</div>
					</div>
				`;
				listEl.appendChild(card);
			}

			listEl.querySelectorAll<HTMLButtonElement>('[data-delete-lead]').forEach((btn) => {
				btn.addEventListener('click', async () => {
					await supabase.from('leads').delete().eq('id', btn.dataset.deleteLead);
					loadLeads();
				});
			});
		}

		function escapeHtml(str: string) {
			const div = document.createElement('div');
			div.textContent = str;
			return div.innerHTML;
		}
	}
</script>
