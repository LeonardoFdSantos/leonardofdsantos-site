---
import type { SiteConfig } from '../site.config';
import Logo from './Logo.astro';

interface Props {
	siteConfig: SiteConfig;
}

const { personal } = Astro.props.siteConfig;
const waLink = `https://wa.me/${personal.whatsapp}`;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-100">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 py-3.5 flex items-center justify-between">
		<a href="/" class="flex items-center gap-2.5">
			<Logo class="h-9 w-9 rounded-xl shrink-0" id="logo-header" />
			<span class="text-sm sm:text-base font-bold tracking-tight text-[var(--color-secondary)] truncate max-w-[200px] sm:max-w-none">
				{personal.name}
			</span>
		</a>

		<!-- Desktop Nav -->
		<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
			<a href="/#sobre" class="hover:text-[var(--color-primary)] transition-colors">Sobre</a>
			<a href="/blog" class="hover:text-[var(--color-primary)] transition-colors">Blog</a>
			<a href="/portfolio" class="hover:text-[var(--color-primary)] transition-colors">Portfólio</a>
			<a href="/#planos" class="hover:text-[var(--color-primary)] transition-colors">Planos</a>
			<a href="/#contato" class="hover:text-[var(--color-primary)] transition-colors">Contato</a>
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={waLink}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden sm:inline-flex rounded-full bg-[var(--color-primary)] px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-[var(--color-primary)]/30 hover:opacity-90 transition-opacity"
			>
				WhatsApp
			</a>

			<!-- Mobile Menu Button -->
			<button
				id="menu-btn"
				type="button"
				class="md:hidden p-2 rounded-xl text-slate-600 hover:text-[var(--color-primary)] hover:bg-slate-100 transition-colors focus:outline-none"
				aria-label="Abrir menu"
			>
				<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Menu Dropdown -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-3 pb-5 shadow-lg">
		<nav class="flex flex-col gap-3 text-base font-medium text-slate-700">
			<a href="/#sobre" class="mobile-link px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[var(--color-primary)] transition-colors">Sobre</a>
			<a href="/blog" class="mobile-link px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[var(--color-primary)] transition-colors">Blog</a>
			<a href="/portfolio" class="mobile-link px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[var(--color-primary)] transition-colors">Portfólio</a>
			<a href="/#planos" class="mobile-link px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[var(--color-primary)] transition-colors">Planos & Preços</a>
			<a href="/#contato" class="mobile-link px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[var(--color-primary)] transition-colors">Contato</a>
			<div class="pt-2 border-t border-slate-100">
				<a
					href={waLink}
					target="_blank"
					rel="noopener noreferrer"
					class="block text-center rounded-xl bg-[var(--color-primary)] px-4 py-3 text-sm font-bold text-white shadow-md shadow-[var(--color-primary)]/30"
				>
					Falar no WhatsApp
				</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const mobileLinks = document.querySelectorAll('.mobile-link');

	if (menuBtn && mobileMenu) {
		menuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});

		mobileLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu.classList.add('hidden');
			});
		});
	}
</script>
