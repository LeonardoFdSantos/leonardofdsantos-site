---
// Vitrine dos sites já criados (as demos em site-clientes/). Enquanto
// cada demo não estiver publicada, o card aparece sem link clicável —
// preencha o campo "url" em site.config.ts assim que publicar na Netlify.
// Projetos com status "encerrado" aparecem esmaecidos, com um selo
// indicando que não estão mais no ar (ex: Luma).
import type { SiteConfig } from '../site.config';

interface Props {
	siteConfig: SiteConfig;
}

const { portfolio } = Astro.props.siteConfig;
---

<section id="portfolio" class="bg-slate-50 py-16 sm:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="text-center">
			<p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary)]">
				Portfólio
			</p>
			<h2 class="mt-2 text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-secondary)]">
				Sites que já criei
			</h2>
			<p class="mx-auto mt-3 max-w-xl text-slate-600">
				Cada projeto abaixo foi feito sob medida pro nicho do cliente — veja um exemplo de cada tipo de site que posso criar pro seu negócio.
			</p>
		</div>
		<div class="mt-12 grid gap-6 sm:grid-cols-2">
			{portfolio.map((item) => {
				const isEncerrado = item.status === "encerrado";
				return (
					<div
						class:list={[
							"group overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-all",
							isEncerrado ? "opacity-70" : "hover:shadow-xl hover:-translate-y-1",
						]}
					>
						<div class="relative h-40 overflow-hidden bg-slate-100">
							{item.image ? (
								<img
									src={item.image}
									alt=""
									loading="lazy"
									class:list={[
										"h-full w-full object-cover transition-transform duration-300",
										isEncerrado ? "grayscale" : "group-hover:scale-105",
									]}
								/>
							) : (
								<div class="h-full w-full bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-secondary)]" />
							)}
							<div class="absolute inset-0 bg-gradient-to-t from-black/35 via-black/0 to-black/0" />
							<span class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-xl bg-white/90 text-xl shadow-sm backdrop-blur-sm">
								{item.icon}
							</span>
							<span class="absolute right-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-600 backdrop-blur-sm">
								{item.niche}
							</span>
						</div>
						<div class="p-6">
							<h3 class="text-xl font-bold text-[var(--color-secondary)]">{item.name}</h3>
							<p class="mt-2 text-sm text-slate-600">{item.description}</p>
							{isEncerrado ? (
								<span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-slate-400">
									<span class="h-1.5 w-1.5 rounded-full bg-slate-400" />
									Projeto encerrado
								</span>
							) : item.url ? (
								<a
									href={item.url}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-primary)] group-hover:gap-2 transition-all"
								>
									Ver site <span aria-hidden="true">→</span>
								</a>
							) : (
								<span class="mt-4 inline-block text-sm font-medium text-slate-400">
									Demo em produção
								</span>
							)}
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>
