---
import type { SiteConfig } from '../site.config';
import Logo from './Logo.astro';

interface Props {
	siteConfig: SiteConfig;
}

const { personal, hero } = Astro.props.siteConfig;
const waLink = `https://wa.me/${personal.whatsapp}`;
---

<section id="topo" class="relative overflow-hidden bg-white" itemscope itemtype="https://schema.org/Person">
	<div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-[var(--color-primary)]/15 blur-3xl"></div>
	<div class="pointer-events-none absolute -bottom-32 -left-24 h-96 w-96 rounded-full bg-[var(--color-secondary)]/10 blur-3xl"></div>

	<div class="relative mx-auto max-w-6xl px-4 sm:px-6 py-20 sm:py-28">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div class="text-center lg:text-left">
				<span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-1.5 text-xs font-semibold text-slate-600">
					<span class="h-2 w-2 rounded-full bg-emerald-500"></span>
					{hero.badge}
				</span>

				<h1 class="mt-6 text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--color-secondary)] leading-[1.1]" itemprop="name">
					{personal.name} - {personal.role}
				</h1>
				<meta itemprop="jobTitle" content={personal.role} />
				<meta itemprop="description" content={personal.description} />
				<p class="mx-auto lg:mx-0 mt-5 max-w-xl text-lg text-slate-600" itemprop="description">
					{hero.subheadline}
				</p>

				<div class="mt-8 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
					<a
						href={waLink}
						target="_blank"
						rel="noopener noreferrer"
						class="w-full sm:w-auto rounded-full bg-[var(--color-primary)] px-6 py-3 text-base font-semibold text-white shadow-lg shadow-[var(--color-primary)]/30 hover:opacity-90 transition-opacity"
					>
						{hero.ctaText}
					</a>
					<a
						href="#portfolio"
						class="w-full sm:w-auto rounded-full border border-slate-300 px-6 py-3 text-base font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
					>
						Ver portfólio
					</a>
				</div>

				<dl class="mt-12 grid grid-cols-3 gap-6 border-t border-slate-100 pt-8">
					{hero.stats.map((stat) => (
						<div class="text-center lg:text-left">
							<dt class="sr-only">{stat.label}</dt>
							<dd class="text-2xl sm:text-3xl font-extrabold text-[var(--color-secondary)]">{stat.value}</dd>
							<dd class="mt-1 text-xs sm:text-sm text-slate-500">{stat.label}</dd>
						</div>
					))}
				</dl>
			</div>

			<div class="hidden lg:flex justify-center">
				<div class="relative">
					{personal.photo ? (
						<img
							src={personal.photo}
							alt={`Foto de ${personal.name}, ${personal.role} em ${personal.city}`}
							class="h-72 w-72 rounded-[2.5rem] object-cover shadow-2xl shadow-[var(--color-primary)]/30"
							itemprop="image"
						/>
					) : (
						<Logo class="h-72 w-72 rounded-[2.5rem] shadow-2xl shadow-[var(--color-primary)]/30" id="logo-hero" />
					)}
					<span class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-white px-5 py-2 text-sm font-semibold text-[var(--color-secondary)] shadow-md">
						{personal.role}
					</span>
				</div>
			</div>
		</div>
	</div>
</section>
