---
import type { SiteConfig } from '../site.config';

interface Props {
  siteConfig: SiteConfig;
}

const { siteConfig } = Astro.props;

const meses: Record<string, string> = {
  "Janeiro": "01", "Fevereiro": "02", "Março": "03", "Abril": "04",
  "Maio": "05", "Junho": "06", "Julho": "07", "Agosto": "08",
  "Setembro": "09", "Outubro": "10", "Novembro": "11", "Dezembro": "12"
};

const parseDate = (dateStr: string) => {
  const [dia, resto] = dateStr.split(' de ');
  const [mes, ano] = resto.split(', ');
  return new Date(`${ano}-${meses[mes]}-${dia.padStart(2, '0')}`);
};

// Ordena os posts do mais novo para o mais velho
const sortedPosts = [...siteConfig.blogPosts].sort((a, b) => {
  return parseDate(b.date).getTime() - parseDate(a.date).getTime();
});

const recentPosts = sortedPosts.slice(0, 3);
---

<section id="blog-recente" class="py-20 bg-slate-50/70 border-t border-slate-100">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[var(--color-primary)] bg-[var(--color-primary)]/10 px-3.5 py-1 rounded-full mb-4">
          📚 Conteúdo & SEO Local
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[var(--color-secondary)] tracking-tight">Últimos Artigos do Blog</h2>
        <p class="mt-3 text-lg text-slate-600 max-w-2xl">Dicas, guias e estratégias de presença digital para empresas e comércios no Rio Grande do Sul.</p>
      </div>
      <div class="mt-6 md:mt-0">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 shadow-sm hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-all"
        >
          Ver todos os artigos <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {recentPosts.map((post) => (
        <article class="group flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div>
            {post.image && (
              <div class="relative h-48 overflow-hidden bg-slate-100">
                <img
                  src={post.image}
                  alt={post.title}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent" />
                <span class="absolute bottom-3 left-4 text-xs font-semibold text-white bg-black/60 px-3 py-1 rounded-full backdrop-blur-sm">
                  {post.date}
                </span>
              </div>
            )}
            <div class="p-6">
              <h3 class="text-xl font-bold text-[var(--color-secondary)] group-hover:text-[var(--color-primary)] transition-colors line-clamp-2">
                {post.title}
              </h3>
              <p class="mt-3 text-sm text-slate-600 leading-relaxed line-clamp-3">
                {post.description}
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-0">
            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-[var(--color-primary)] hover:gap-2.5 transition-all"
            >
              Ler artigo completo <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
