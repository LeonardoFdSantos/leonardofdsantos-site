---
import type { SiteConfig } from '../site.config';

interface Props {
	siteConfig: SiteConfig;
}

const { personal, contact } = Astro.props.siteConfig;
const waLink = `https://wa.me/${personal.whatsapp}`;
const igLink = personal.instagram ? `https://instagram.com/${personal.instagram}` : undefined;
---

<section id="contato" class="bg-slate-50 py-16 sm:py-24">
	<div class="mx-auto max-w-5xl px-4 sm:px-6">
		<div class="overflow-hidden rounded-3xl bg-white shadow-sm border border-slate-100">
			<div class="grid gap-10 p-8 sm:p-12 sm:grid-cols-2">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary)]">
						Contato
					</p>
					<h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[var(--color-secondary)]">
						Vamos conversar sobre o seu site?
					</h2>
					<p class="mt-3 text-slate-600">
						Me chama pelo WhatsApp ou preenche o formulário — respondo rapidinho.
					</p>

					<div class="mt-8 space-y-4">
						<p class="flex items-center gap-3 text-slate-600">
							<span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-50 text-lg">📍</span>
							{personal.city}
						</p>
						{personal.email && (
							<p class="flex items-center gap-3 text-slate-600">
								<span class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-50 text-lg">✉️</span>
								{personal.email}
							</p>
						)}
					</div>

					<div class="mt-6 flex gap-3">
						<a
							href={waLink}
							target="_blank"
							rel="noopener noreferrer"
							class="rounded-full bg-[var(--color-primary)] px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-[var(--color-primary)]/30 hover:opacity-90 transition-opacity"
						>
							WhatsApp
						</a>
						{igLink && (
							<a
								href={igLink}
								target="_blank"
								rel="noopener noreferrer"
								class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors"
							>
								Instagram
							</a>
						)}
					</div>
				</div>

				{contact.showForm && (
					<form
						id="contact-form"
						class="space-y-3"
						data-web3forms-key={contact.web3formsKey}
						data-subject={`Novo contato via site pessoal - ${personal.name}`}
					>
						<input
							type="text"
							name="name"
							placeholder="Seu nome"
							required
							class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[var(--color-primary)] focus:bg-white focus:outline-none transition-colors"
						/>
						<input
							type="tel"
							name="phone"
							placeholder="Seu telefone"
							required
							class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[var(--color-primary)] focus:bg-white focus:outline-none transition-colors"
						/>
						<textarea
							name="message"
							placeholder="Me conta um pouco sobre seu negócio"
							rows="4"
							required
							class="w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[var(--color-primary)] focus:bg-white focus:outline-none transition-colors"
						></textarea>
						<button
							type="submit"
							class="w-full rounded-lg bg-[var(--color-primary)] px-4 py-3 text-sm font-semibold text-white hover:opacity-90 transition-opacity disabled:opacity-60"
						>
							Enviar mensagem
						</button>
						<p id="contact-status" class="hidden text-sm"></p>
					</form>
				)}
			</div>
		</div>
	</div>
</section>

<script>
	import { supabase } from '../lib/supabase';

	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const statusEl = document.querySelector<HTMLElement>('#contact-status');

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!statusEl) return;

		const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
		submitBtn.disabled = true;

		const fd = new FormData(form);
		const name = String(fd.get('name') ?? '');
		const phone = String(fd.get('phone') ?? '');
		const message = String(fd.get('message') ?? '');

		// Guarda o lead no Supabase pra aparecer no /admin. Se o Supabase
		// não estiver configurado ainda, apenas segue pro Web3Forms.
		if (supabase) {
			await supabase.from('leads').insert({ name, phone, message }).then(
				() => {},
				() => {} // falha silenciosa aqui — o e-mail via Web3Forms abaixo é o fallback
			);
		}

		try {
			const web3formsKey = form.dataset.web3formsKey;
			const res = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify({
					access_key: web3formsKey,
					subject: form.dataset.subject,
					name,
					phone,
					message,
				}),
			});
			const data = await res.json();

			if (data.success) {
				statusEl.textContent = 'Mensagem enviada! Te respondo em breve 🙂';
				statusEl.className = 'text-sm text-emerald-600';
				form.reset();
			} else {
				throw new Error(data.message || 'Falha no envio');
			}
		} catch {
			statusEl.textContent = 'Não consegui enviar agora — chama no WhatsApp que é mais rápido.';
			statusEl.className = 'text-sm text-red-600';
		} finally {
			statusEl.classList.remove('hidden');
			submitBtn.disabled = false;
		}
	});
</script>
